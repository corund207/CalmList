{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalmList",
  "version": "1.0.0",
  "identifier": "com.corund207.calmlist",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/build-native.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CalmList",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm, keyboard-first task manager.",
    "longDescription": "Plan less. Finish more. A keyboard-first task manager with smart quick add, free on-device AI and sync through Supabase or your own server.",
    "copyright": "© 2026 Jonah Chang. MIT License.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
