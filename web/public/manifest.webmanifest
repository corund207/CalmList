{
  "name": "CalmList",
  "short_name": "CalmList",
  "description": "A calm, keyboard-first task manager.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./#/today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inbox", "url": "./#/inbox", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Upcoming", "url": "./#/upcoming", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
